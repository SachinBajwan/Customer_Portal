(SELECT A.UNIT_CD FROM USER_UNIT A 
WHERE EXISTS (SELECT B.USER_ID FROM (SELECT USER_ID FROM USER_MASTER
WHERE USER_NAME = NVL(:P_USER_NAME,USER_NAME))B WHERE A.USER_ID=B.USER_ID))
ORDER BY CODE ASC]]></SQLQuery>
