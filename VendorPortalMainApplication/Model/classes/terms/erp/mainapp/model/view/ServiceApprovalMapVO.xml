<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="ServiceApprovalMapVO"
  Version="12.2.1.11.57"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="terms.erp.mainapp.model.view.ServiceApprovalMapVO_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="VENDOR_ID"
    Kind="where"
    Type="java.lang.Long"/>
  <SQLQuery><![CDATA[Select Listagg(DESCRIPTION, ', ') WITHIN GROUP(Order by SERVICE_ID) DESCRIPTION,EMAIL_ID
  From (select PVS.DESCRIPTION,EMAIL_ID ,service_id from PORTAL_SER_APROV_MAIL SAM JOIN PORTAL_VENDOR_SERVICE PVS USING (SERVICE_ID)
        WHERE service_id in (select   CAPITAL_ITEM   from portal_vendor_supply_map pvsm where pvsm.VENDOR_ID=:VENDOR_ID))
  GROUP BY EMAIL_ID]]></SQLQuery>
  <ViewAttribute
    Name="Description"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="255"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="DESCRIPTION"
    Expression="DESCRIPTION"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="4000"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="EmailId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="40"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="EMAIL_ID"
    Expression="EMAIL_ID"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="40"/>
    </DesignTime>
  </ViewAttribute>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="terms.erp.mainapp.model.ModelBundle"/>
  </ResourceBundle>
</ViewObject>
