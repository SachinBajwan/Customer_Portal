<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="CustomerOnboardTF">
    <default-activity>CreateInsert</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <view id="businessDetails">
      <page>/fragments/businessDetails.jsff</page>
      <train-stop>
        <display-name>Business Details</display-name>
      </train-stop>
    </view>
    <view id="contactPerson">
      <page>/fragments/contactPerson.jsff</page>
      <train-stop>
        <display-name>Contact Person</display-name>
      </train-stop>
    </view>    
    <view id="kycDocuments">
      <page>/fragments/kycDocuments.jsff</page>
       <train-stop>
        <display-name>KYC Documents</display-name>
      </train-stop>
    </view>
    <view id="privacyConsent">
      <page>/fragments/privacyConsent.jsff</page>
      <train-stop>
        <display-name>Privacy Consent</display-name>
      </train-stop>
    </view>
    <view id="reviewSubmit">
      <page>/fragments/reviewSubmit.jsff</page>
      <train-stop>
        <display-name>Review and Submit</display-name>
      </train-stop>
    </view>
    <method-call id="CreateInsert">
      <method>#{bindings.CreateInsert.execute}</method>
      <outcome>
        <fixed-outcome>CreateInsert</fixed-outcome>
      </outcome>
    </method-call>
    <train/>
    <!-- NAVIGATION -->


        <control-flow-rule>
            <from-activity-id>contactPerson</from-activity-id>
      <control-flow-case id="__3">
        <from-outcome>back</from-outcome>
        <to-activity-id>businessDetails</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__9">
        <from-outcome>next</from-outcome>
        <to-activity-id>kycDocuments</to-activity-id>
      </control-flow-case>
    </control-flow-rule>


        <control-flow-rule>
            <from-activity-id>privacyConsent</from-activity-id>

            <control-flow-case>
                <from-outcome>next</from-outcome>
                <to-activity-id>reviewSubmit</to-activity-id>
            </control-flow-case>
      <control-flow-case id="__22">
        <from-outcome>back</from-outcome>
        <to-activity-id>kycDocuments</to-activity-id>
      </control-flow-case>
    </control-flow-rule>


        <control-flow-rule>
            <from-activity-id>reviewSubmit</from-activity-id>

            <control-flow-case>
                <from-outcome>back</from-outcome>
                <to-activity-id>privacyConsent</to-activity-id>
            </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__1">
      <from-activity-id>businessDetails</from-activity-id>
      <control-flow-case id="__2">
        <from-outcome>next</from-outcome>
        <to-activity-id>contactPerson</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__7">
      <from-activity-id>CreateInsert</from-activity-id>
      <control-flow-case id="__8">
        <from-outcome>CreateInsert</from-outcome>
        <to-activity-id>businessDetails</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__18">
      <from-activity-id>kycDocuments</from-activity-id>
      <control-flow-case id="__19">
        <from-outcome>back</from-outcome>
        <to-activity-id>contactPerson</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__20">
        <from-outcome>next</from-outcome>
        <to-activity-id>privacyConsent</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
