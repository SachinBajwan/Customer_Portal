<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:f="http://java.sun.com/jsf/core"
          xmlns:af="http://xmlns.oracle.com/adf/faces/rich" xmlns:h="http://java.sun.com/jsf/html">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <f:view>
        <af:document title="ForgotPassword.jspx" id="d1">
            <f:facet name="metaContainer">
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <af:resource type="css" source="/resource/css/bootstrap.min.css"/>
                <af:resource type="css" source="/resource/css/Signup.css"/>
            </f:facet>
            <af:form id="f1">
                <af:panelGroupLayout id="pgl1" styleClass="signup-container">
                    <af:panelGroupLayout id="pgl5" styleClass="signup-header">
                        <af:panelGroupLayout styleClass="brand-row">
                            <af:outputText value="CP" styleClass="brand-logo"/>
                            <af:outputText value="CUSTOMER PORTAL" styleClass="brand-name"/>                        
                        </af:panelGroupLayout>
                    </af:panelGroupLayout>
                    
                    <af:panelGroupLayout id="pgl3" styleClass="forgot-mainwrapper">
                        <af:panelGroupLayout id="pgl4" styleClass="forgot-wrapper">
                            
                                <af:panelGroupLayout id="pgl6" styleClass="forgot-header">
                                    <h:outputLabel value="Forgot Password" id="ol1"/>
                                </af:panelGroupLayout>
                                <af:panelGroupLayout styleClass="forgot-section">
                                    <af:panelGroupLayout id="pgl2" styleClass="forgot-formwrapper">
                                        <af:panelGroupLayout id="pgl7" styleClass="input-fields">                                               
                                            <af:inputText label="Customer Code" id="it1" autoSubmit="true" styleClass="input-field"/>
                                            <af:inputText label="PAN" id="it4" autoSubmit="true"
                                                          validator="#{ResetPasswordBean.validatePAN}"
                                                          valueChangeListener="#{ResetPasswordBean.PanVce}"
                                                           styleClass="input-field"/>
                                            <af:inputText label="Password" id="it2" secret="true" autoSubmit="true" styleClass="input-field">
                                                <af:validateRegExp pattern="^(((?=.*[a-z])(?=.*[A-Z]))|((?=.*[a-z])(?=.*\\\\d))|((?=.*[A-Z])(?=.*\\\\d))).{8,}$"
                                                                       messageDetailNoMatch="Password must be at least 8 characters long and include uppercase, lowercase, number, and special character."/>
                                            </af:inputText>
                                            <af:inputText label="Confirm Password" id="it3" secret="true" autoSubmit="true" styleClass="input-field">
                                                <af:validateRegExp pattern="^(((?=.*[a-z])(?=.*[A-Z]))|((?=.*[a-z])(?=.*\\\\d))|((?=.*[A-Z])(?=.*\\\\d))).{8,}$"
                                                                       messageDetailNoMatch="Password must be at least 8 characters long and include uppercase, lowercase, number, and special character."/>
                                            </af:inputText>                                            <af:spacer width="0" height="10" id="s4"/>
                                        </af:panelGroupLayout>
                                         <af:panelGroupLayout id="pgl8" styleClass="toolbar">
                                            <af:button text="Reset" id="b1"
                                                       actionListener="#{ResetPasswordBean.validateResetPassword}"
                                                       binding="#{ResetPasswordBean.bindResetBtn}"
                                                       styleClass="login-button submit"/>
                                            <af:spacer width="10" height="0" id="s7"/>
                                            <af:button text="Back To Login" id="b3"
                                                       actionListener="#{LoginBean.backToLoginPage}"
                                                       immediate="true" styleClass="login-button back"/>
                                        </af:panelGroupLayout>
                                    </af:panelGroupLayout>
                                    <!--<af:image source="/resource/image/forgot_password.jpeg" id="i1"
                                              inlineStyle="width:163px; height:129px;"/>-->
                                </af:panelGroupLayout>
                        </af:panelGroupLayout>
                    </af:panelGroupLayout>
                </af:panelGroupLayout>
            </af:form>
        </af:document>
    </f:view>
</jsp:root>
