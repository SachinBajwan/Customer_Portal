<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://xmlns.oracle.com/adfm/application" version="12.2.1.11.57" id="DataBindings"
             SeparateXMLFiles="false" Package="view.bspl.track" ClientType="Generic">
  <definitionFactories>
    <factory nameSpace="http://xmlns.oracle.com/adf/controller/binding"
             className="oracle.adf.controller.internal.binding.TaskFlowBindingDefFactoryImpl"/>
    <dtfactory className="oracle.adf.controller.internal.dtrt.binding.BindingDTObjectFactory"/>
  </definitionFactories>
  <pageMap>
    <page path="/OrderTracking.jspx" usageId="view_bspl_track_OrderTrackingPageDef"/>
    <page path="/fragments/orderTrack.jsff" usageId="view_bspl_track_orderTrackPageDef"/>
  </pageMap>
  <pageDefinitionUsages>
    <page id="view_bspl_track_OrderTrackingPageDef" path="view.bspl.track.pageDefs.OrderTrackingPageDef"/>
    <page id="view_bspl_track_orderTrackPageDef" path="fragments.orderTrackPageDef"/>
  </pageDefinitionUsages>
  <dataControlUsages>
    <BC4JDataControl id="OrderTrackAMDataControl" Package="model.bspl.track.services"
                     FactoryClass="oracle.adf.model.bc4j.DataControlFactoryImpl" SupportsTransactions="true"
                     SupportsFindMode="true" SupportsRangesize="true" SupportsResetState="true"
                     SupportsSortCollection="true" Configuration="OrderTrackAMLocal" syncMode="Immediate"
                     xmlns="http://xmlns.oracle.com/adfm/datacontrol"/>
  </dataControlUsages>
</Application>
