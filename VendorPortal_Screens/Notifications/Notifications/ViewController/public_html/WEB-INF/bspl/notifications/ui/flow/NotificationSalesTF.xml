<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="NotificationSalesTF">
    <default-activity>getNotifications</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__2">
      <name>vendorId</name>
      <value>#{pageFlowScope.vendorId}</value>
      <class>java.lang.Long</class>
    </input-parameter-definition>
    <managed-bean id="__1">
      <managed-bean-name>notificationBean</managed-bean-name>
      <managed-bean-class>view.bspl.notification.beans.notificationBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="NotificationScreen">
      <page>/fragments/NotificationScreen.jsff</page>
    </view>
    <method-call id="getNotifications">
      <method>#{bindings.getNotifications.execute}</method>
      <outcome>
        <fixed-outcome>getNotifications</fixed-outcome>
      </outcome>
    </method-call>
    <control-flow-rule id="__3">
      <from-activity-id>getNotifications</from-activity-id>
      <control-flow-case id="__4">
        <from-outcome>getNotifications</from-outcome>
        <to-activity-id>NotificationScreen</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
