        <to-activity-id>setOrderHdr</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__7">
      <from-activity-id>getOrderDetail</from-activity-id>
      <control-flow-case id="__8">
        <from-outcome>getOrderDetail</from-outcome>
        <to-activity-id>createOrders</to-activity-id>
