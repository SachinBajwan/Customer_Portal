      <class>java.lang.Long</class>
    </input-parameter-definition>
    <input-parameter-definition id="__15">
      <name>mode</name>
      <value>#{pageFlowScope.mode}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <input-parameter-definition id="__16">
      <name>userId</name>
