<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="TicketsTF">
    <default-activity>getTicketDetail</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__2">
      <name>vendorId</name>
      <value>#{pageFlowScope.vendorId}</value>
      <class>java.lang.Long</class>
    </input-parameter-definition>
    <managed-bean id="__1">
      <managed-bean-name>TicketBean</managed-bean-name>
      <managed-bean-class>view.bspl.self.beans.TicketBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="Tickets">
      <page>/fragments/Tickets.jsff</page>
    </view>
    <method-call id="getTicketDetail">
      <method>#{bindings.getTicketDetail.execute}</method>
      <outcome>
        <fixed-outcome>getTicketDetail</fixed-outcome>
      </outcome>
    </method-call>
    <task-flow-return id="taskFlowReturn1">
      <outcome>
        <name>taskFlowReturn1</name>
      </outcome>
    </task-flow-return>
    <control-flow-rule id="__3">
      <from-activity-id>getTicketDetail</from-activity-id>
      <control-flow-case id="__4">
        <from-outcome>getTicketDetail</from-outcome>
        <to-activity-id>Tickets</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__5">
      <from-activity-id>Tickets</from-activity-id>
      <control-flow-case id="__6">
        <from-outcome>back</from-outcome>
        <to-activity-id>taskFlowReturn1</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
