<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="ProfileTF">
    <default-activity>getProfileDetail</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__1">
      <name>vendorId</name>
      <value>#{pageFlowScope.vendorId}</value>
      <class>java.lang.Long</class>
    </input-parameter-definition>
    <managed-bean id="__8">
      <managed-bean-name>ProfileBean</managed-bean-name>
      <managed-bean-class>view.bspl.self.beans.ProfileBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="ProfileDetails">
      <page>/fragments/ProfileDetails.jsff</page>
    </view>
    <method-call id="getProfileDetail">
      <method>#{bindings.getProfileDetail.execute}</method>
      <outcome>
        <fixed-outcome>getProfileDetail</fixed-outcome>
      </outcome>
    </method-call>
    <method-call id="Rollback">
      <method>#{bindings.Rollback.execute}</method>
      <outcome>
        <fixed-outcome>Rollback</fixed-outcome>
      </outcome>
    </method-call>
    <task-flow-return id="taskFlowReturn1">
      <outcome>
        <name>taskFlowReturn1</name>
      </outcome>
    </task-flow-return>
    <control-flow-rule id="__2">
      <from-activity-id>getProfileDetail</from-activity-id>
      <control-flow-case id="__3">
        <from-outcome>getProfileDetail</from-outcome>
        <to-activity-id>ProfileDetails</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__4">
      <from-activity-id>ProfileDetails</from-activity-id>
      <control-flow-case id="__5">
        <from-outcome>back</from-outcome>
        <to-activity-id>Rollback</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__6">
      <from-activity-id>Rollback</from-activity-id>
      <control-flow-case id="__7">
        <from-outcome>Rollback</from-outcome>
        <to-activity-id>taskFlowReturn1</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
