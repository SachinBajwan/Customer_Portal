<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
          xmlns:f="http://java.sun.com/jsf/core">



  <af:panelGroupLayout id="changePasswordPage"
                         layout="vertical"
                         styleClass="change-password-page">

        <!-- HEADER -->

        <af:panelGroupLayout id="header"
                             layout="vertical"
                             styleClass="password-header">

            <af:outputText value="Change Password"
                           styleClass="password-title"/>

            <af:outputText value="Update your password to keep your account secure."
                           styleClass="password-subtitle"/>

        </af:panelGroupLayout>


        <!-- PASSWORD CARD -->

        <af:panelGroupLayout id="passwordCard"
                             layout="vertical"
                             styleClass="password-card">
            <af:inputText value="#{bindings.UserId.inputValue}" label="#{bindings.UserId.hints.label}"
                          required="#{bindings.UserId.hints.mandatory}" columns="#{bindings.UserId.hints.displayWidth}"
                          maximumLength="#{bindings.UserId.hints.precision}"
                          shortDesc="#{bindings.UserId.hints.tooltip}" id="it1" disabled="true"
                          contentStyle="width:80px;">
                <f:validator binding="#{bindings.UserId.validator}"/>
            </af:inputText>
            <!-- CURRENT PASSWORD -->

            <af:outputText value="Current Password"
                           styleClass="password-label"/>

            <af:panelGroupLayout id="currentPasswordRow"
                                 layout="horizontal"
                                 styleClass="password-input-row">

                <af:inputText id="currentPassword"
                              secret="true"
                              required="true"
                              placeholder="Enter current password"
                              styleClass="password-input"
                              maximumLength="100" value="#{pageFlowScope.ChangePasswordBean.currentPassword}"/>

            </af:panelGroupLayout>


            <!-- NEW PASSWORD -->

            <af:outputText value="New Password"
                           styleClass="password-label"/>

            <af:panelGroupLayout id="newPasswordRow"
                                 layout="horizontal"
                                 styleClass="password-input-row">

                <af:inputText id="newPassword"
                              value="#{pageFlowScope.ChangePasswordBean.newPassword}"
                              secret="true"
                              required="true"
                              placeholder="Enter new password"
                              styleClass="password-input"
                              maximumLength="100"/>

            </af:panelGroupLayout>


            <!-- PASSWORD RULES -->

            <af:panelGroupLayout id="passwordRules"
                                 layout="vertical"
                                 styleClass="password-rules">

                <af:outputText value="Password must contain:"
                               styleClass="rules-heading"/>

                <af:outputText value="&#8226; Minimum 8 characters"
                               styleClass="rule-text"/>

                <af:outputText value="&#8226; At least one uppercase letter"
                               styleClass="rule-text"/>

                <af:outputText value="&#8226; At least one lowercase letter"
                               styleClass="rule-text"/>

                <af:outputText value="&#8226; At least one number"
                               styleClass="rule-text"/>

                <af:outputText value="&#8226; At least one special character"
                               styleClass="rule-text"/>

            </af:panelGroupLayout>


            <!-- CONFIRM PASSWORD -->

            <af:outputText value="Confirm New Password"
                           styleClass="password-label"/>

            <af:panelGroupLayout id="confirmPasswordRow"
                                 layout="horizontal"
                                 styleClass="password-input-row">

                <af:inputText id="confirmPassword"
                              value="#{pageFlowScope.ChangePasswordBean.confirmPassword}"
                              secret="true"
                              required="true"
                              placeholder="Re-enter new password"
                              styleClass="password-input"
                              maximumLength="100"/>

            </af:panelGroupLayout>


            <!-- MESSAGE -->

            <af:messages id="passwordMessages"
                        styleClass="password-messages"/>


            <!-- BUTTONS -->

            <af:panelGroupLayout id="buttonPanel"
                                 layout="horizontal"
                                 styleClass="password-button-row">

                <af:commandButton id="changeButton"
                                  text="Change Password"
                                  action="#{pageFlowScope.ChangePasswordBean.changePassword}"
                                  styleClass="change-password-button"
                                  partialSubmit="false"/>

                <af:commandButton id="cancelButton"
                                  text="Cancel"
                                  action="#{pageFlowScope.ChangePasswordBean.cancel}"
                                  immediate="true"
                                  styleClass="cancel-password-button"/>

            </af:panelGroupLayout>

        </af:panelGroupLayout>


        <!-- SECURITY FOOTER -->

        <af:panelGroupLayout id="securityFooter"
                             layout="horizontal"
                             styleClass="password-footer">

            <af:outputText value="&#128274;"
                           styleClass="security-icon"/>

            <af:outputText value="Your password is securely protected."
                           styleClass="security-text"/>

        </af:panelGroupLayout>

    </af:panelGroupLayout>
  
  
  
</jsp:root>
