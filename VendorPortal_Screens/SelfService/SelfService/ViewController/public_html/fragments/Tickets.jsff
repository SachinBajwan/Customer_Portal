<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
          xmlns:f="http://java.sun.com/jsf/core">
  <af:panelGroupLayout id="st_pgl1" layout="vertical" styleClass="content-area">
    
    <!-- Main Form Panel Card -->
    <af:outputText value="Raise a Support Ticket" id="st_ot_title" styleClass="panel-title" inlineStyle="margin-bottom: 15px; font-size: 16px;"/>
    <!-- Create Ticket Button -->
                   
    <!-- Support Tickets History Table -->
 <af:button text="+ Create" id="co_b1" styleClass="btn btn-primary"
                  actionListener="#{pageFlowScope.TicketBean.createTicket}"/>
    <af:panelGroupLayout id="st_pgl_table_card" styleClass="panel">
      <af:table value="#{bindings.TicketMasterVO1.collectionModel}" var="row"
                rows="#{bindings.TicketMasterVO1.rangeSize}"
                emptyText="#{bindings.TicketMasterVO1.viewable ? 'No data to display.' : 'Access Denied.'}"
                rowBandingInterval="0" selectedRowKeys="#{bindings.TicketMasterVO1.collectionModel.selectedRow}"
                selectionListener="#{bindings.TicketMasterVO1.collectionModel.makeCurrent}" rowSelection="single"
                fetchSize="#{bindings.TicketMasterVO1.rangeSize}"
                filterModel="#{bindings.TicketMasterVO1Query.queryDescriptor}" filterVisible="true"
                queryListener="#{bindings.TicketMasterVO1Query.processQuery}" varStatus="vs" id="t1"
                styleClass="recent-orders-table" partialTriggers="::co_b1" binding="#{pageFlowScope.TicketBean.bndTable}">
        <af:column sortProperty="#{bindings.TicketMasterVO1.hints.TicketId.name}" filterable="true"
                   headerText="#{bindings.TicketMasterVO1.hints.TicketId.label}" id="c1" visible="false">
          <af:inputText value="#{row.bindings.TicketId.inputValue}"
                        label="#{bindings.TicketMasterVO1.hints.TicketId.label}"
                        required="#{bindings.TicketMasterVO1.hints.TicketId.mandatory}"
                        columns="#{bindings.TicketMasterVO1.hints.TicketId.displayWidth}"
                        maximumLength="#{bindings.TicketMasterVO1.hints.TicketId.precision}"
                        shortDesc="#{bindings.TicketMasterVO1.hints.TicketId.tooltip}" id="it4">
            <f:validator binding="#{row.bindings.TicketId.validator}"/>
            <af:convertNumber groupingUsed="false" pattern="#{bindings.TicketMasterVO1.hints.TicketId.format}"/>
          </af:inputText>
        </af:column>
        <af:column sortProperty="#{bindings.TicketMasterVO1.hints.TicketNo.name}" filterable="true"
                   headerText="Ticket No" id="c2" width="150" align="center" headerClass="recent-orders-header">
          <af:inputText value="#{row.bindings.TicketNo.inputValue}"
                        label="#{bindings.TicketMasterVO1.hints.TicketNo.label}"
                        required="#{bindings.TicketMasterVO1.hints.TicketNo.mandatory}"
                        columns="#{bindings.TicketMasterVO1.hints.TicketNo.displayWidth}"
                        maximumLength="#{bindings.TicketMasterVO1.hints.TicketNo.precision}"
                        shortDesc="#{bindings.TicketMasterVO1.hints.TicketNo.tooltip}" id="it5" readOnly="true">
            <f:validator binding="#{row.bindings.TicketNo.validator}"/>
          </af:inputText>
        </af:column>
        <af:column sortProperty="#{bindings.TicketMasterVO1.hints.Category.name}" filterable="true"
                   headerText="#{bindings.TicketMasterVO1.hints.Category.label}" id="c3" width="150" align="center"
                   headerClass="recent-orders-header">
          <af:inputText value="#{row.bindings.Category.inputValue}"
                        label="#{bindings.TicketMasterVO1.hints.Category.label}"
                        required="#{bindings.TicketMasterVO1.hints.Category.mandatory}"
                        columns="#{bindings.TicketMasterVO1.hints.Category.displayWidth}"
                        maximumLength="#{bindings.TicketMasterVO1.hints.Category.precision}"
                        shortDesc="#{bindings.TicketMasterVO1.hints.Category.tooltip}" id="it6" readOnly="true">
            <f:validator binding="#{row.bindings.Category.validator}"/>
          </af:inputText>
        </af:column>
        <af:column headerText="Invoice No" id="c6" width="150" align="center" headerClass="recent-orders-header">
          <af:inputText value="#{row.bindings.InvoiceNo.inputValue}"
                        label="#{bindings.TicketMasterVO1.hints.InvoiceNo.label}"
                        required="#{bindings.TicketMasterVO1.hints.InvoiceNo.mandatory}"
                        columns="#{bindings.TicketMasterVO1.hints.InvoiceNo.displayWidth}"
                        maximumLength="#{bindings.TicketMasterVO1.hints.InvoiceNo.precision}"
                        shortDesc="#{bindings.TicketMasterVO1.hints.InvoiceNo.tooltip}" id="it9" readOnly="true">
            <f:validator binding="#{row.bindings.InvoiceNo.validator}"/>
          </af:inputText>
        </af:column>
        <af:column headerText="#{bindings.TicketMasterVO1.hints.Priority.label}" id="c7" align="center"
                   headerClass="recent-orders-header">
          <af:inputText value="#{row.bindings.Priority.inputValue}"
                        label="#{bindings.TicketMasterVO1.hints.Priority.label}"
                        required="#{bindings.TicketMasterVO1.hints.Priority.mandatory}"
                        columns="#{bindings.TicketMasterVO1.hints.Priority.displayWidth}"
                        maximumLength="#{bindings.TicketMasterVO1.hints.Priority.precision}"
                        shortDesc="#{bindings.TicketMasterVO1.hints.Priority.tooltip}" id="it10" readOnly="true">
            <f:validator binding="#{row.bindings.Priority.validator}"/>
          </af:inputText>
        </af:column>
        <af:column sortProperty="#{bindings.TicketMasterVO1.hints.RaisedOn.name}" filterable="true"
                   headerText="Raised On" id="c4" width="130" align="center" headerClass="recent-orders-header">
          <f:facet name="filter">
            <af:inputDate value="#{bindings.TicketMasterVO1Query.queryDescriptor.filterConjunctionCriterion.criterionMap.RaisedOn.value}"
                          id="id1">
              <af:convertDateTime pattern="#{bindings.TicketMasterVO1.hints.RaisedOn.format}"/>
            </af:inputDate>
          </f:facet>
          <af:inputDate value="#{row.bindings.RaisedOn.inputValue}"
                        label="#{bindings.TicketMasterVO1.hints.RaisedOn.label}"
                        required="#{bindings.TicketMasterVO1.hints.RaisedOn.mandatory}"
                        columns="#{bindings.TicketMasterVO1.hints.RaisedOn.displayWidth}"
                        shortDesc="#{bindings.TicketMasterVO1.hints.RaisedOn.tooltip}" id="id2" readOnly="true">
                        <af:convertDateTime pattern="dd-MMM-yy"/>
            <f:validator binding="#{row.bindings.RaisedOn.validator}"/>
            <af:convertDateTime pattern="#{bindings.TicketMasterVO1.hints.RaisedOn.format}"/>
          </af:inputDate>
        </af:column>
        <af:column sortProperty="#{bindings.TicketMasterVO1.hints.Status.name}" filterable="true"
                   headerText="#{bindings.TicketMasterVO1.hints.Status.label}" id="c5" width="150" align="center"
                   headerClass="recent-orders-header">
          <af:inputText value="#{row.bindings.Status.inputValue}" label="#{bindings.TicketMasterVO1.hints.Status.label}"
                        required="#{bindings.TicketMasterVO1.hints.Status.mandatory}"
                        columns="#{bindings.TicketMasterVO1.hints.Status.displayWidth}"
                        maximumLength="#{bindings.TicketMasterVO1.hints.Status.precision}"
                        shortDesc="#{bindings.TicketMasterVO1.hints.Status.tooltip}" id="it7" readOnly="true">
            <f:validator binding="#{row.bindings.Status.validator}"/>
          </af:inputText>
        </af:column>
        <af:column headerText="#{bindings.TicketMasterVO1.hints.Description.label}" id="c8" width="300" align="center"
                   headerClass="recent-orders-header">
          <af:inputText value="#{row.bindings.Description.inputValue}"
                        label="#{bindings.TicketMasterVO1.hints.Description.label}"
                        required="#{bindings.TicketMasterVO1.hints.Description.mandatory}"
                        columns="#{bindings.TicketMasterVO1.hints.Description.displayWidth}"
                        maximumLength="#{bindings.TicketMasterVO1.hints.Description.precision}"
                        shortDesc="#{bindings.TicketMasterVO1.hints.Description.tooltip}" id="it11" readOnly="true">
            <f:validator binding="#{row.bindings.Description.validator}"/>
          </af:inputText>
        </af:column>
      </af:table>
    </af:panelGroupLayout>
    <af:panelGroupLayout id="pgl2" styleClass="footer-action-bar">
      <af:button text="Cancel" id="co_b_cancel" styleClass="btn btn-outline-danger" action="back" immediate="true"/>
    </af:panelGroupLayout>
  </af:panelGroupLayout>
  <af:popup childCreation="deferred" autoCancel="disabled" id="p1" binding="#{pageFlowScope.TicketBean.bindTicketPop}">
    <af:dialog id="d1" title="Create a Support Ticket" closeIconVisible="false"
               dialogListener="#{pageFlowScope.TicketBean.saveTicket}" type="yesNo">
      <f:facet name="buttonBar"/>
      <af:panelGroupLayout id="st_pgl_card" styleClass="panel" inlineStyle="margin-bottom: 25px;" layout="vertical">
        <!-- Top Form Inputs Grid (Category, Related Order, Priority) -->
        <af:panelGroupLayout id="pgl1" layout="horizontal" inlineStyle="margin-bottom: 15px;">
          <af:inputText value="#{bindings.Category.inputValue}" label="#{bindings.Category.hints.label}"
                        required="#{bindings.Category.hints.mandatory}"
                        columns="#{bindings.Category.hints.displayWidth}"
                        maximumLength="#{bindings.Category.hints.precision}"
                        shortDesc="#{bindings.Category.hints.tooltip}" id="it1" contentStyle="width:200px;">
            <f:validator binding="#{bindings.Category.validator}"/>
          </af:inputText>
          <af:inputText value="#{bindings.InvoiceNo.inputValue}" label="#{bindings.InvoiceNo.hints.label}"
                        required="#{bindings.InvoiceNo.hints.mandatory}"
                        columns="#{bindings.InvoiceNo.hints.displayWidth}"
                        maximumLength="#{bindings.InvoiceNo.hints.precision}"
                        shortDesc="#{bindings.InvoiceNo.hints.tooltip}" id="it2" contentStyle="width:200px;">
            <f:validator binding="#{bindings.InvoiceNo.validator}"/>
          </af:inputText>
          <af:inputText value="#{bindings.Priority.inputValue}" label="#{bindings.Priority.hints.label}"
                        required="#{bindings.Priority.hints.mandatory}"
                        columns="#{bindings.Priority.hints.displayWidth}"
                        maximumLength="#{bindings.Priority.hints.precision}"
                        shortDesc="#{bindings.Priority.hints.tooltip}" id="it3" contentStyle="width:200px;">
            <f:validator binding="#{bindings.Priority.validator}"/>
          </af:inputText>
        </af:panelGroupLayout>
        <af:panelGroupLayout id="st_pgl_desc" layout="vertical" inlineStyle="margin-bottom: 15px;">
          <af:inputText value="#{bindings.Description.inputValue}" label="#{bindings.Description.hints.label}"
                        required="#{bindings.Description.hints.mandatory}"
                        columns="#{bindings.Description.hints.displayWidth}"
                        maximumLength="#{bindings.Description.hints.precision}"
                        shortDesc="#{bindings.Description.hints.tooltip}" id="it8" rows="4"
                        placeholder="Describe your issue (max 1000 characters)" styleClass="notes-textarea">
            <f:validator binding="#{bindings.Description.validator}"/>
          </af:inputText>
        </af:panelGroupLayout>
        <!-- Description Textarea -->
        <!-- Attachment & Submit Action Row -->
      </af:panelGroupLayout>
    </af:dialog>
  </af:popup>
</jsp:root>
