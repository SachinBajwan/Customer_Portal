<?xml version = '1.0' encoding = 'UTF-8'?>
<BC4JConfig version="11.1" xmlns="http://xmlns.oracle.com/bc4j/configuration">
   <AppModuleConfigBag ApplicationName="model.bspl.self.services.SelfServiceAM">
      <AppModuleConfig name="SelfServiceAMLocal" jbo.project="model.bspl.self.Model" ApplicationName="model.bspl.self.services.SelfServiceAM" DeployPlatform="LOCAL">
         <Database jbo.TypeMapEntries="OracleApps"/>
         <Security AppModuleJndiName="model.bspl.self.services.SelfServiceAM"/>
         <Custom ns0:JDBCDataSource="java:comp/env/jdbc/APPLICATIONDBDS" xmlns:ns0="http://xmlns.oracle.com/bc4j/configuration"/>
      </AppModuleConfig>
      <AppModuleConfig name="SelfServiceAMShared" jbo.project="model.bspl.self.Model" ApplicationName="model.bspl.self.services.SelfServiceAM" DeployPlatform="LOCAL">
         <AM-Pooling jbo.ampool.maxpoolsize="1" jbo.ampool.isuseexclusive="false"/>
         <Database jbo.TypeMapEntries="OracleApps"/>
         <Security AppModuleJndiName="model.bspl.self.services.SelfServiceAM"/>
         <Custom ns0:JDBCDataSource="java:comp/env/jdbc/APPLICATIONDBDS" xmlns:ns0="http://xmlns.oracle.com/bc4j/configuration"/>
      </AppModuleConfig>
   </AppModuleConfigBag>
</BC4JConfig>
