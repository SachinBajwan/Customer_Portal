<?xml version = '1.0' encoding = 'UTF-8'?>
<BC4JConfig version="11.1" xmlns="http://xmlns.oracle.com/bc4j/configuration">
   <AppModuleConfigBag ApplicationName="model.bspl.docs.services.DocumentAM">
      <AppModuleConfig name="DocumentAMLocal" jbo.project="model.bspl.docs.Model" ApplicationName="model.bspl.docs.services.DocumentAM" DeployPlatform="LOCAL">
         <Database jbo.TypeMapEntries="OracleApps"/>
         <Security AppModuleJndiName="model.bspl.docs.services.DocumentAM"/>
         <Custom ns0:JDBCDataSource="java:comp/env/jdbc/APPLICATIONDBDS" xmlns:ns0="http://xmlns.oracle.com/bc4j/configuration"/>
      </AppModuleConfig>
      <AppModuleConfig name="DocumentAMShared" jbo.project="model.bspl.docs.Model" ApplicationName="model.bspl.docs.services.DocumentAM" DeployPlatform="LOCAL">
         <AM-Pooling jbo.ampool.maxpoolsize="1" jbo.ampool.isuseexclusive="false"/>
         <Database jbo.TypeMapEntries="OracleApps"/>
         <Security AppModuleJndiName="model.bspl.docs.services.DocumentAM"/>
         <Custom ns0:JDBCDataSource="java:comp/env/jdbc/APPLICATIONDBDS" xmlns:ns0="http://xmlns.oracle.com/bc4j/configuration"/>
      </AppModuleConfig>
   </AppModuleConfigBag>
</BC4JConfig>
