<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="DashboardTF">
    <default-activity>CustomerDashboard</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__2">
      <name>vendorId</name>
      <value>#{pageFlowScope.vendorId}</value>
      <class>java.lang.Long</class>
    </input-parameter-definition>
    <input-parameter-definition id="__3">
      <name>sessionId</name>
      <value>#{pageFlowScope.sessionId}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <input-parameter-definition id="__4">
      <name>userId</name>
      <value>#{pageFlowScope.userId}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <managed-bean id="__1">
      <managed-bean-name>DashboardBean</managed-bean-name>
      <managed-bean-class>view.bspl.dashboard.beans.DashboardBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="CustomerDashboard">
      <page>/fragments/CustomerDashboard.jsff</page>
    </view>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
