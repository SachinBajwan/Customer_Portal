<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="UserSessionVO"
  Version="12.2.1.11.57"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="model.bspl.dashboard.views.UserSessionVO_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="userId"
    Kind="where"
    Type="java.lang.String">
    <TransientExpression
      Name="VariableScript"
      trustMode="trusted"
      CodeSourceName="UserSessionVO"/>
  </Variable>
  <SQLQuery><![CDATA[select to_char(login_time,'fmDay Month fmDD, YYYY')login_date,
to_char(login_time,'hh:mi')login_tm,
substr(machine,1,instr(machine,'/',1)-1)machine_ip
from (
select user_id,machine,login_time,logout_time,dense_rank() over(order by login_time desc)rnk from 
USER_SESSION WHERE USER_ID=:userId and nvl(logout_time,login_time) is not null)
where rnk=2]]></SQLQuery>
  <ViewAttribute
    Name="LoginDate"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="255"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="LOGIN_DATE"
    Expression="LOGIN_DATE"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="82"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="LoginTm"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="5"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="LOGIN_TM"
    Expression="LOGIN_TM"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="5"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="MachineIp"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="100"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="MACHINE_IP"
    Expression="MACHINE_IP"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="100"/>
    </DesignTime>
  </ViewAttribute>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="model.bspl.dashboard.ModelBundle"/>
  </ResourceBundle>
</ViewObject>
