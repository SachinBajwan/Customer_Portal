<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="DefaultRegionFlow">
    <default-activity>DefaultRegionPage</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <managed-bean id="__1">
      <managed-bean-name>DynamicRegionBean</managed-bean-name>
      <managed-bean-class>terms.defaultregion.view.bean.DynamicRegionBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <initializer>#{pageFlowScope.DynamicRegionBean.initializer}</initializer>
    <finalizer>#{pageFlowScope.DynamicRegionBean.finalizer}</finalizer>
    <view id="DefaultRegionPage">
      <page>/DefaultRegionPage.jsff</page>
    </view>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
