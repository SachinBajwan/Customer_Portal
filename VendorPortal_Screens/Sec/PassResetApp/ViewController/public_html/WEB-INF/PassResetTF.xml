<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="PassResetTF">
    <default-activity>PassReset</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__1">
      <name>UserId</name>
      <value>#{pageFlowScope.UserId}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <input-parameter-definition id="__2">
      <name>empCode</name>
      <value>#{pageFlowScope.empCode}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <managed-bean id="__3">
      <managed-bean-name>PassResetAppBean</managed-bean-name>
      <managed-bean-class>bspl.sec.passresetapp.bean.PassResetAppBean</managed-bean-class>
      <managed-bean-scope>request</managed-bean-scope>
    </managed-bean>
    <view id="PassReset">
      <page>/WEB-INF/PassReset.jsff</page>
    </view>
    <task-flow-return id="taskFlowReturn1">
      <outcome>
        <name>taskFlowReturn1</name>
      </outcome>
    </task-flow-return>
    <control-flow-rule id="__4">
      <from-activity-id>PassReset</from-activity-id>
      <control-flow-case id="__5">
        <from-outcome>goBack</from-outcome>
        <to-activity-id>taskFlowReturn1</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
