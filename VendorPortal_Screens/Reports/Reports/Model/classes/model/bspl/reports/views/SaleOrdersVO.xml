    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[SELECT A.ACK_NUMBER
           ,
       A.AMEND_ACK_NUMBER
           ,
       A.ACK_DATE
           ,
       A.CUST_PO_NUMBER
           ,
       A.CUST_PO_DATE
           ,
       A.CUST_AMEND_NUMBER
           ,
       A.DESTINATION
           ,
       A.SHIP_MODE
           ,
       A.VALID_UPTO
           ,
       A.CURRANCY_CODE
           ,
       DECODE (A.STATUS, 'A', 'ACTIVE')
           STATUS,
       A.CUST_CODE
           ,
       DECODE (A.CUST_PLANT_CODE, 'HO', 'HEAD OFFICE')
         CUST_PLANT_CODE  ,
       D.NAME
           ,
       A.CUST_CITY_CODE
           ,
       DECODE (D.CUST_TYPE,  'OE', 'OPEN MARKET',  'EXP', 'EXPORT')
           CUST_TYPE,
       A.SALES_TAX_CODE
           ,
       DECODE (A.SALES_TAX_TYPE,  'V', 'VAT',  'C', 'CESS')
        SALES_TAX_TYPE   ,
       C.TAX_RATE
           ,
       A.UNIT_CODE
           ,
       DECODE (A.PO_TYPE,
               'PO', 'PURCHASE ORDER',
               'JO', 'JOB ORDER',
               'RM', 'RAW MATERIAL')
           PO_TYPE,
       DECODE (A.MARKET_TYPE,  'DOM', 'DOMESTIC',  'EXP', 'EXPORT')
           MKT_TYPE,
       B.DISCOUNT
           ,
       B.PRICE
           ,
       B.QUANTITY
           ,
       B.HSN_NO,
       A.GST_CODE,
       A.SHIP_CUST_CD,
       B.SGST,
       B.CGST,
       ROUND (B.IGST, 0)
           IGST,
       B.SGST_RATE,
       B.CGST_RATE,
       B.IGST_RATE,
       B.UOM,
       B.PACK_UOM,
       B.PACK_QTY,
       B.CUST_MRP_PRICE
           ,
       A.APPROVED_BY,
       INITCAP (em.EMP_FIRST_NAME || ' ' || em.EMP_LAST_NAME)
           APPROVED_BY_NAME,
       A.CREATED_BY,
       INITCAP (em1.EMP_FIRST_NAME || ' ' || em1.EMP_LAST_NAME)
           CREATED_BY_NAME,
       A.SHIP_CUST_CD
           SHIP_TO,
       vm.NAME
           SHIP_TO_NAME,
       da.DA_NO
           DESPATCH_ADVICE_NO,
       IM.ITEM_DESC
           ITEM_DESCRIPTION,
       B.BRAND_CODE,
       bm.BRAND_DESCRIPTION
           BRAND_DESCRIPTION,
       B.PROD_CODE
           ITEM_CODE,
       b.CUST_CODE
           BILL_TO,
       vm1.NAME
           BILL_TO_NAME
  FROM PURCHASE_ORDER_HEADER_SYN  A
       LEFT JOIN PURCHASE_ORDER_DETAIL_SYN B
           ON A.ACK_NUMBER = B.PO_HEAD_ACK_NUMBER
       LEFT JOIN SALES_TAX_SYN C
           ON A.SALES_TAX_CODE = C.STAX_CD AND A.SALES_TAX_TYPE = C.STAX_TYPE
       LEFT JOIN CUSTOMER_SYN D
           ON A.UNIT_CODE = D.UNIT_CODE AND B.CUST_CODE = D.CODE
       LEFT JOIN UNIT_SYN U ON A.UNIT_CODE = U.CODE
       LEFT JOIN (  SELECT DA_NO, PO_ACK_NUMBER, COUNT (DA_NO)
                      FROM DESPATCH_ADVICE_DETAIL_SYN
                     WHERE status <> 'C'
                  GROUP BY DA_NO, PO_ACK_NUMBER) da
           ON da.PO_ACK_NUMBER = A.ACK_NUMBER
       LEFT JOIN ITEM_STOCK_SYN IM ON IM.ITEM_CD = B.PROD_CODE
       LEFT JOIN VENDOR_MASTER_SYN vm ON vm.VENDOR_CODE = A.SHIP_CUST_CD
       LEFT JOIN VENDOR_MASTER_SYN vm1 ON vm1.VENDOR_CODE = b.CUST_CODE
       LEFT JOIN EMP_MASTER_SYN em ON em.EMP_NUMBER = A.APPROVED_BY
       LEFT JOIN EMP_MASTER_SYN em1 ON em1.EMP_NUMBER = A.CREATED_BY
       LEFT JOIN BRAND_MASTER_SYN bm ON bm.BRAND_CODE = B.BRAND_CODE
       WHERE A.CUST_CODE = :P_CUST_CD
  AND (
        -- Scenario 1: ACK Number + Customer Code
        (
            :P_ACK_NUMBER IS NOT NULL
            AND A.ACK_NUMBER = :P_ACK_NUMBER
        )

        OR

        -- Scenario 2: Date Range + Customer Code
        (
            :P_ACK_NUMBER IS NULL
            AND :P_FROM_DATE IS NOT NULL
            AND :P_TO_DATE IS NOT NULL
            AND TRUNC(A.ACK_DATE) BETWEEN
                TO_DATE(:P_FROM_DATE, 'DD-MM-YY')
                AND TO_DATE(:P_TO_DATE, 'DD-MM-YY')
        )

        OR

        -- Scenario 3: All Parameters
        (
            :P_ACK_NUMBER IS NOT NULL
            AND :P_FROM_DATE IS NOT NULL
            AND :P_TO_DATE IS NOT NULL
            AND A.ACK_NUMBER = :P_ACK_NUMBER
            AND TRUNC(A.ACK_DATE) BETWEEN
                TO_DATE(:P_FROM_DATE, 'DD-MM-YY')
                AND TO_DATE(:P_TO_DATE, 'DD-MM-YY')
        )
      )]]></SQLQuery>
