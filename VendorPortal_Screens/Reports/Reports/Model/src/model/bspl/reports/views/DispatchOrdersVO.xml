  <Variable
    Name="P_FROM_DATE"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="P_TO_DATE"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="P_CUST_CD"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="P_DOC_NO"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[SELECT D.DA_NO,
   H.CUST_CODE ,
       (SELECT SAP_NUMBER
          FROM PRODUCT_SYN
         WHERE CODE = D.PRODUCT_CODE)    SAP_NO,
       D.PRODUCT_CODE,
       (SELECT DESCRIPTION
          FROM PRODUCT_SYN
         WHERE CODE = D.PRODUCT_CODE)    DESCRIPITION,
       D.HSN_NO,
       D.MRP,
       D.BATCH_NO,
       D.MFG_DT,
       D.EXP_DT,
       D.UOM,
       D.QTY AS QTY,
       D.RATE,                                                    --D.GST_CODE
       H.TRANSPORTER_CODE AS Transporter,
       H.DA_DATE,
       H.PO_ACK_NO AS SO_Ref,
       H.STATUS,
       H.UNIT_CD AS UnitCode,
       H.VEHICLE_NO AS Vehicle,
       (SELECT GST_RATE
          FROM GST_RATE_MASTER_SYN
         WHERE GST_CODE = D.GST_CODE)    GST_RATE,
       D.PACK_QTY                        PACK_SIZE,
       (SELECT DISTINCT CONVER_FACT
          FROM ITEM_PACKING_UOM_SYN
         WHERE ITEM_CD = D.PRODUCT_CODE AND UNIT_CD = H.UNIT_CD
         FETCH FIRST ROW ONLY)           STANDARD_SIZE
  FROM DESPATCH_ADVICE_DETAIL_SYN D, DESPATCH_ADVICE_HEADER_SYN H
WHERE H.DA_NO =D.DA_NO
AND H.CUST_CODE = :P_CUST_CD

  AND (
        -- Scenario 1: DA Number + Customer Code
        (
            :P_DOC_NO IS NOT NULL
            AND H.DA_NO = :P_DOC_NO
        )

        OR

        -- Scenario 2: Date Range + Customer Code
        (
            :P_DOC_NO IS NULL
            AND :P_FROM_DATE IS NOT NULL
            AND :P_TO_DATE IS NOT NULL
            AND TRUNC(H.DA_DATE) BETWEEN
                TO_DATE(:P_FROM_DATE, 'DD-MM-YY')
                AND TO_DATE(:P_TO_DATE, 'DD-MM-YY')
        )

        OR

        -- Scenario 3: All Parameters
        (
            :P_DOC_NO IS NOT NULL
            AND :P_FROM_DATE IS NOT NULL
            AND :P_TO_DATE IS NOT NULL
            AND H.DA_NO = :P_DOC_NO
            AND TRUNC(H.DA_DATE) BETWEEN
                TO_DATE(:P_FROM_DATE, 'DD-MM-YY')
                AND TO_DATE(:P_TO_DATE, 'DD-MM-YY')
        )
      )]]></SQLQuery>
