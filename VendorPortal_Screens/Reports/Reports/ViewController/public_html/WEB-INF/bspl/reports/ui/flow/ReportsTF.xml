<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="ReportsTF">
    <default-activity>Reports</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__2">
      <name>vendorId</name>
      <value>#{pageFlowScope.vendorId}</value>
      <class>java.lang.Long</class>
    </input-parameter-definition>
    <managed-bean id="__1">
      <managed-bean-name>ReportsBean</managed-bean-name>
      <managed-bean-class>view.bspl.reports.beans.ReportsBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="Reports">
      <page>/fragments/Reports.jsff</page>
    </view>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
