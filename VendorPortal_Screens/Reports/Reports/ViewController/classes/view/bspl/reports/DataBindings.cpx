<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://xmlns.oracle.com/adfm/application" version="12.2.1.11.57" id="DataBindings"
             SeparateXMLFiles="false" Package="view.bspl.reports" ClientType="Generic">
  <definitionFactories>
    <factory nameSpace="http://xmlns.oracle.com/adf/controller/binding"
             className="oracle.adf.controller.internal.binding.TaskFlowBindingDefFactoryImpl"/>
    <dtfactory className="oracle.adf.controller.internal.dtrt.binding.BindingDTObjectFactory"/>
  </definitionFactories>
  <pageMap>
    <page path="/Reportss.jspx" usageId="view_bspl_reports_ReportssPageDef"/>
    <page path="/fragments/Reports.jsff" usageId="view_bspl_reports_ReportsPageDef"/>
  </pageMap>
  <pageDefinitionUsages>
    <page id="view_bspl_reports_ReportssPageDef" path="view.bspl.reports.pageDefs.ReportssPageDef"/>
    <page id="view_bspl_reports_ReportsPageDef" path="fragments.ReportsPageDef"/>
  </pageDefinitionUsages>
  <dataControlUsages>
    <BC4JDataControl id="ReportsAMDataControl" Package="model.bspl.reports.services"
                     FactoryClass="oracle.adf.model.bc4j.DataControlFactoryImpl" SupportsTransactions="true"
                     SupportsFindMode="true" SupportsRangesize="true" SupportsResetState="true"
                     SupportsSortCollection="true" Configuration="ReportsAMLocal" syncMode="Immediate"
                     xmlns="http://xmlns.oracle.com/adfm/datacontrol"/>
  </dataControlUsages>
</Application>
